PROCESSOS_ENVIRONMENT=development
PROCESSOS_LOG_LEVEL=INFO
PROCESSOS_DATABASE_URL=postgresql+asyncpg://processos:processos@db:5432/processos
PROCESSOS_JWT_SECRET=replace-with-at-least-32-random-characters
PROCESSOS_PASSWORD_RESET_BASE_URL=http://localhost:3001/reset-password
# Configure SMTP before enabling password recovery outside local development.
PROCESSOS_SMTP_HOST=
PROCESSOS_SMTP_PORT=587
PROCESSOS_SMTP_USERNAME=
PROCESSOS_SMTP_PASSWORD=
PROCESSOS_SMTP_FROM=
PROCESSOS_CORS_ORIGINS=["http://localhost:3000"]
PROCESSOS_OVERPASS_ENDPOINTS=["https://overpass.private.coffee/api/interpreter","https://overpass-api.de/api/interpreter","https://maps.mail.ru/osm/tools/overpass/api/interpreter"]
POSTGRES_DB=processos
POSTGRES_USER=processos
POSTGRES_PASSWORD=processos
NEXT_PUBLIC_API_URL=http://localhost:8000
PROCESSOS_API_URL=http://localhost:8000
COMMERCIAL_APP_PORT=3001
AUDIT_WEB_PORT=3000
